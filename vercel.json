{
  "version": 2,
  "regions": [
    "hkg1"
  ],
  "functions": {
    "api/gemini.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/lesson-migration",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/makeup-push",
      "schedule": "0 23 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/report/:slug",
      "destination": "/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/parent/:endpoint",
      "destination": "/api/parent?__endpoint=:endpoint"
    },
    {
      "source": "/api/student/:endpoint",
      "destination": "/api/student?__endpoint=:endpoint"
    },
    {
      "source": "/api/cron/lesson-migration",
      "destination": "/api/teacher/workspace?__cron=lesson-migration"
    },
    {
      "source": "/api/cron/makeup-push",
      "destination": "/api/teacher/workspace?__cron=makeup-push"
    },
    {
      "source": "/api/hooks/new-signups",
      "destination": "/api/teacher/workspace?__hook=new-signups"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
