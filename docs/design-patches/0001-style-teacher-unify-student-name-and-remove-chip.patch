+
+/* Input design tokens are scoped to the teacher room, including its dialogs. */
+.teacher-workspace {
+ --lesson-pink:#f4729c; --lesson-soft:#fff5f8; --lesson-border:#fce7ef; --lesson-accent:#be416c;
+ --lesson-text:#334155; --lesson-muted:#64748b; --lesson-neutral:#e2e8f0; --lesson-white:#fff;
+ --lesson-focus:#ec4899; --lesson-radius:12px; --lesson-pill:999px;
+ --lesson-shadow:0 3px 10px #be416c18; --lesson-bar-shadow:0 -5px 20px #be416c0d;
+ --lesson-green:#15803d; --lesson-green-soft:#f0fdf4; --lesson-red:#be123c; --lesson-red-soft:#fff1f2;
+ --lesson-yellow:#a16207; --lesson-yellow-soft:#fefce8; --lesson-grey:#94a3b8;
+}
+.teacher-workspace .grid-student-strip {display:flex;flex-wrap:nowrap;gap:8px;overflow-x:auto;scroll-snap-type:x proximity;padding:4px;margin:-4px -4px 12px;scrollbar-width:thin;}
+.teacher-workspace .grid-student-chip {display:flex;flex:none;align-items:center;scroll-snap-align:start;height:36px;border-radius:var(--lesson-pill);border:1px solid var(--lesson-border);background:var(--lesson-soft);color:var(--lesson-accent);}
+.teacher-workspace .grid-student-chip.is-active {background:var(--lesson-pink);color:var(--lesson-white);border-color:var(--lesson-pink);box-shadow:var(--lesson-shadow);}
+.teacher-workspace .grid-student-name {display:flex;align-items:center;gap:7px;min-width:0;height:100%;padding:0 14px;border:0;border-radius:var(--lesson-pill);background:transparent;color:inherit;font-size:12px;font-weight:700;}
+.grid-student-name-text {max-width:140px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
+.teacher-workspace .grid-student-remove {display:grid;place-items:center;flex:none;width:32px;height:32px;padding:0;margin-right:2px;border:0;border-radius:var(--lesson-pill);color:inherit;background:transparent;}
+.grid-student-remove>span {display:grid;place-items:center;width:20px;height:20px;border-radius:var(--lesson-pill);}
+.teacher-workspace .grid-student-chip button:not(:disabled):hover {background:transparent;box-shadow:none;}
+.teacher-workspace .grid-student-name:not(:disabled):hover {background:#be416c08;}
+.grid-student-remove:not(:disabled):hover>span {background:#be416c16;}
+.is-active .grid-student-remove:not(:disabled):hover>span {background:#ffffff40;}
+.teacher-workspace .grid-student-chip button:not(:disabled):active {opacity:.75;}
+.teacher-workspace .grid-student-chip button:disabled {opacity:.4;cursor:not-allowed;}
+.teacher-workspace .grid-student-chip button:focus-visible {outline:2px solid var(--lesson-focus);outline-offset:2px;}
+.lesson-status-dot {display:inline-block;flex:none;width:6px;height:6px;border-radius:var(--lesson-pill);background:var(--lesson-grey);box-shadow:0 0 0 1px #ffffff90;}
+.lesson-status-dot.status-pink {background:var(--lesson-pink);}
+.lesson-status-dot.status-green {background:var(--lesson-green);}
+.lesson-status-dot.status-red {background:var(--lesson-red);}
+.lesson-status-dot.status-yellow {background:var(--lesson-yellow);}
+@media(max-width:640px){.teacher-workspace .grid-student-chip{height:44px;}.teacher-workspace .grid-student-remove{width:44px;height:44px;margin-right:0;}}
