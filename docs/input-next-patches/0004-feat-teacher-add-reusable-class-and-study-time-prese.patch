+});
+test('class and study reuse preset groups, retain required native inputs and expose manual details',()=>{
+ const html=renderToStaticMarkup(<LessonAcademyFields value={{classSession:'있음',selfStudy:'있음',start:'14:00',end:'15:20',selfStudyStart:'15:20',selfStudyEnd:'16:40',round:1,selfStudyRound:2}} regularTime={{start:'14:00',end:'15:20'}} onChange={()=>{}}/>);
+ assert.ok(html.includes('오늘 정규 14:00–15:20'));assert.equal((html.match(/시간 직접 입력/g)||[]).length,2);assert.equal((html.match(/aria-pressed="true"/g)||[]).length,2);assert.ok(html.includes('aria-label="자습 시작"'));assert.ok(html.includes('value="15:20"'));assert.ok(html.includes('type="time"'));
