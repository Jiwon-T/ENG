+.student-combobox-popup {position:absolute;top:100%;left:0;right:0;z-index:6;max-height:min(280px,var(--student-list-height,280px));overflow:auto;background:var(--lesson-white);border:1px solid var(--lesson-border);border-radius:var(--lesson-radius);box-shadow:var(--lesson-shadow);padding:4px;overscroll-behavior:contain;}
+.student-combobox[data-placement=above] .student-combobox-popup {top:auto;bottom:calc(100% - 20px);}
+.student-combobox-group {font-size:11px;font-weight:700;color:var(--lesson-muted);padding:6px 10px;}
+.student-combobox-option {display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:40px;padding:8px 10px;border-radius:8px;font-size:13px;color:var(--lesson-text);cursor:pointer;}
+.student-combobox-option:hover,.student-combobox-option.is-active {background:var(--lesson-soft);color:var(--lesson-accent);}
+.student-combobox-option[aria-selected=true] {font-weight:700;}
+.student-today-tag {font-size:10px;padding:2px 6px;background:var(--lesson-soft);color:var(--lesson-accent);border-radius:var(--lesson-pill);}
+.student-combobox-empty {font-size:12px;padding:12px;color:var(--lesson-muted);}
+.teacher-workspace .student-combobox input:focus-visible {outline:2px solid var(--lesson-focus);outline-offset:2px;}
+@media(max-width:640px){.student-combobox-option{min-height:44px;}.student-combobox-popup{max-height:min(280px,var(--student-list-height,280px));}}
