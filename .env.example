# ==============================================================================
# Vercel Serverless Functions Server-Only Environment Variables (.env)
# 주의: 이 파일의 변수들은 서버 전용이며, 절대 'VITE_' 접두사를 붙이지 마세요.
# 실제 비밀키나 운영 자격증명 값은 절대 GitHub에 커밋하지 마세요.
# ==============================================================================

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=

# Access Control & Security
ADMIN_UID=
PHONE_PIN_PEPPER=
PARENT_SESSION_SECRET=

# Legacy override: firestore forces app template reads even without the template switch (normally unset).
MESSAGE_TEMPLATE_READ_MODE=
# Legacy: firestore makes a missing core switch an error instead of "not switched" (normally unset).
ACADEMY_CORE_MODE=

# Scheduler secret (16+ chars) for /api/cron/lesson-migration, which now only empties the lesson
# trash after 7 days. Empty = cron requests are refused.
CRON_SECRET=

# Bati: server-only; exact existing webhook body query parameter must be confirmed.
BATI_WEBHOOK_URL=
BATI_MESSAGE_PARAM=
# Confirm exact webhook recipient key and request protocol before enabling sending.
BATI_RECIPIENT_PARAM=
# GET or POST_JSON, only after matching the actual workflow trigger.
BATI_WEBHOOK_METHOD=
# body-only or legacy-student; legacy-student matches the 12-key Notion formula.
BATI_PAYLOAD_MODE=
# Exact confirmed status/text/JSON acceptance rule. No default 2xx acceptance.
BATI_RESPONSE_RULE=
# Optional security header: keep both empty only when the workflow needs none.
BATI_SECURITY_HEADER_NAME=
BATI_SECURITY_HEADER_VALUE=
